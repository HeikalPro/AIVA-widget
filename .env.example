# =============================================================================
# AIVA Widget — Vite env (must start with VITE_)
# Backend secrets live in AIVA-V2/.env on the server, not here.
# =============================================================================

# --- AIVA-V2 session RAG (recommended) ---
# Production:
VITE_API_BASE_URL=https://www.aiva-backend.goai247.com
VITE_USE_AIVA_SESSION_CHAT=1
# Local Docker:
# VITE_API_BASE_URL=http://127.0.0.1:8007
# VITE_USE_AIVA_SESSION_CHAT=1

# Optional: pin account ID. Omit to use first account from GET /api/accounts.
# VITE_AIVA_ACCOUNT_ID=1
VITE_AIVA_CHAT_TOP_K=10

# Email/password login uses /api/auth/login on VITE_API_BASE_URL.
# VITE_ENABLE_ZOHO_LOGIN=1

# Electron: set 0 when using a remote backend (production).
NEXA_AUTO_START_BACKEND=0
# Require login on every cold start (default 1). Set 0 to remember session across restarts.
NEXA_REQUIRE_LOGIN_ON_LAUNCH=1
# NEXA_AIVA_ROOT=D:\AIVA\AIVA-V2

# --- HAIVA (separate backend, optional) ---
# VITE_API_BASE_URL=http://127.0.0.1:8091
# VITE_SKIP_LOGIN=1
# VITE_USE_HAIVA_CHAT=1
