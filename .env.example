# AIVA-V2 session chat + email/password login (Zoho login off unless VITE_ENABLE_ZOHO_LOGIN=1)
# VITE_API_BASE_URL=http://127.0.0.1:8000
# VITE_USE_AIVA_SESSION_CHAT=1
# VITE_ENABLE_ZOHO_LOGIN=1
# Login: username + provider dropdown (Gmail, Yahoo, Hotmail, …). Set 0 for full email field.
# VITE_LOGIN_EMAIL_PICKER=1

# HAIVA (halan_agent_chat): uvicorn … --port 8091 — no trailing slash on base.
VITE_API_BASE_URL=http://127.0.0.1:8091
VITE_SKIP_LOGIN=1
VITE_USE_HAIVA_CHAT=1

# Optional HAIVA message JSON (see Postman "POST message")
# VITE_HAIVA_CORPUS_ID=2702A1FDE062414B8DAC1FF4347338F1
# VITE_HAIVA_MESSAGE_ROUTE=auto
# VITE_HAIVA_SEARCH_QUERY=

# Legacy FastAPI chat (unset VITE_USE_HAIVA_CHAT or set to 0)
# VITE_API_BASE_URL=https://api.example.com
# VITE_API_LOGIN_PATH=/login
# VITE_API_CHAT_PATH=/chat/
# VITE_LOGIN_MINIMAL_BODY=1
# VITE_CHAT_MODEL_PROVIDER=openai
# VITE_CHAT_CHANNEL_PROMPT_IDS=213
# VITE_CHAT_SYSTEM_MESSAGE=Halan assistant will help call center agents…
# VITE_CHAT_SELECTED_FILE_IDS=108f52c1-b245-4ddf-8651-c614d5b6239c,ada1685f-3803-4b3f-a1fa-b4a687c77101
# VITE_CHAT_CORPUS_ID=2702A1FDE062414B8DAC1FF4347338F1
